{
  "description": "Agent harness hooks shared with Claude Code. Scripts live in ~/.agents/hooks.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$|^apply_patch$",
        "hooks": [{ "type": "command", "command": "python3 \"$HOME/.agents/hooks/guard.py\"", "timeout": 10, "statusMessage": "Checking harness guard" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^apply_patch$",
        "hooks": [{ "type": "command", "command": "python3 \"$HOME/.agents/hooks/format.py\"", "timeout": 90, "statusMessage": "Formatting edited files" }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "python3 \"$HOME/.agents/hooks/verify.py\"", "timeout": 300 }]
      }
    ]
  }
}
